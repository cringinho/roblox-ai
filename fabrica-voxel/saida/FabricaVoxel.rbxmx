		{Nome = "Raiz", Pai = "", Pivo = {0, 0, 0}, Papel = "raiz", Mola = nil},
		{Nome = "Corpo", Pai = "Raiz", Pivo = {0, 2.1875, 0.0625}, Papel = "corpo", Mola = nil},
