<Item class="Folder" referent="RBX98"><Properties><string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX99"><Properties><string name="Name">FabricaGrade</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este Script em ServerScriptService, com o nome FabricaGrade
-- SERVIDOR. Dono da verdade do movimento em grade: valida cada pedido de passo (4 direcoes, uma casa por
-- vez, cadencia minima) e publica os atributos que os clientes desenham. Cria o que faltar.
-- Nao testado no Studio: confira no piloto.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local pastaFabrica = ReplicatedStorage:FindFirstChild("Fabrica")
if not pastaFabrica then
	pastaFabrica = Instance.new("Folder")
	pastaFabrica.Name = "Fabrica"
	pastaFabrica.Parent = ReplicatedStorage
end
local remotos = pastaFabrica:FindFirstChild("Remotos")
if not remotos then
	remotos = Instance.new("Folder")
	remotos.Name = "Remotos"
	remotos.Parent = pastaFabrica
end
local pedir = remotos:FindFirstChild("PedirPasso")
if not pedir then
	pedir = Instance.new("RemoteEvent")
	pedir.Name = "PedirPasso"
	pedir.Parent = remotos
end

local okConfig, Config = pcall(function()
	return require(pastaFabrica:WaitForChild("Config", 10))
end)
local LADRILHO = (okConfig and Config and Config.LADRILHO) or 4
local DURACAO = (okConfig and Config and Config.SEGUNDOS_POR_LADRILHO) or 0.4444

local ocupado: { [Player]: number } = {}

-- Passabilidade plugavel: por padrao bloqueia o que tiver a tag "Bloqueia" na casa de destino.
local function casaLivre(destino: Vector3): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = CollectionService:GetTagged("Bloqueia")
	local achados = Workspace:GetPartBoundsInBox(CFrame.new(destino + Vector3.new(0, 2, 0)), Vector3.new(LADRILHO - 0.5, 3, LADRILHO - 0.5), params)
	return #achados == 0
end

local function unitaria(d: any): Vector3?
	if typeof(d) ~= "Vector3" then
		return nil
	end
	local x, z = math.round(d.X), math.round(d.Z)
	if math.abs(x) + math.abs(z) ~= 1 then
		return nil -- so as 4 direcoes
	end
	return Vector3.new(x, 0, z)
end

(pedir :: RemoteEvent).OnServerEvent:Connect(function(jogador: Player, direcao: any)
	local d = unitaria(direcao)
	local modelo = jogador.Character
	if not d or not modelo or not modelo.PrimaryPart then
		return
	end
	if jogador:GetAttribute("Modo") == "Dungeon" then
		return
	end
	local agora = Workspace:GetServerTimeNow()
	if (ocupado[jogador] or 0) > agora then
		return -- ainda esta no passo anterior
	end
	local de = modelo:GetAttribute("PassoPara")
	if typeof(de) ~= "Vector3" then
		local p = modelo:GetPivot().Position
		de = Vector3.new(math.round(p.X / LADRILHO) * LADRILHO, p.Y, math.round(p.Z / LADRILHO) * LADRILHO)
	end
	local para = (de :: Vector3) + d * LADRILHO
	local rumo = if d.Z < 0 then 0 elseif d.X > 0 then 90 elseif d.Z > 0 then 180 else 270
	modelo:SetAttribute("Rumo", rumo)
	if not casaLivre(para) then
		return
	end
	ocupado[jogador] = agora + DURACAO
	modelo:SetAttribute("PassoDe", de)
	modelo:SetAttribute("PassoPara", para)
	modelo:SetAttribute("PassoDur", DURACAO)
	modelo:SetAttribute("PassoT0", agora)
	modelo:SetAttribute("Velocidade", LADRILHO / DURACAO)
	modelo:SetAttribute("Estado", "Andar")
	CollectionService:AddTag(modelo, "FabricaGrade")
	task.delay(DURACAO + 0.05, function()
		if modelo.Parent and (ocupado[jogador] or 0) <= Workspace:GetServerTimeNow() then
			modelo:SetAttribute("Estado", "Parado")
		end
	end)
end)

Players.PlayerRemoving:Connect(function(jogador)
	ocupado[jogador] = nil
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX100"><Properties><string name="Name">FabricaViveiro</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este Script em ServerScriptService, com o nome FabricaViveiro
-- SERVIDOR, demonstracao. Monta no Workspace uma fileira com todo modelo que tiver Dados_<Id> em
-- ReplicatedStorage > Fabrica > Dados e troca o atributo Estado para voce ver os clipes.
-- Usa o modelo importado (Workspace ou ServerStorage > FabricaModelos, com o nome igual ao Id) se existir;
-- senao monta por Parts. Apague este script quando nao precisar mais da demonstracao.
-- Nao testado no Studio: confira no piloto.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local pasta = ReplicatedStorage:WaitForChild("Fabrica", 15)
if not pasta then
	warn("[FabricaViveiro] nao achei ReplicatedStorage.Fabrica. Rode o instalador do pacote FabricaVoxel primeiro.")
	return
end
local Rig = require(pasta:WaitForChild("Rig"))
local ConstrutorParts = require(pasta:WaitForChild("ConstrutorParts"))
local Catalogo = require(pasta:WaitForChild("Catalogo"))

local viveiro = Workspace:FindFirstChild("FabricaViveiro")
if viveiro then
	viveiro:Destroy()
end
viveiro = Instance.new("Folder")
viveiro.Name = "FabricaViveiro"
viveiro.Parent = Workspace

local modelosImportados = ServerStorage:FindFirstChild("FabricaModelos")
local x = 0
for _, id in ipairs(Catalogo.ids()) do
	local dados = Catalogo.dados(id)
	local clipes = Catalogo.clipes(id)
	if dados then
		local onde = CFrame.new(x, 0.5, 60)
		local modelo: Model? = nil
		local importado = modelosImportados and modelosImportados:FindFirstChild(id)
		if importado and importado:IsA("Model") then
			modelo = importado:Clone()
			if modelo then
				modelo:PivotTo(onde)
			end
		else
			local ok, m = pcall(ConstrutorParts.construir, dados, onde)
			if ok then
				modelo = m
			else
				warn(("[FabricaViveiro] nao consegui montar %s: %s"):format(id, tostring(m)))
			end
		end
		if modelo then
			modelo.Parent = viveiro
			local ok, erro = pcall(Rig.montar, modelo, dados)
			if not ok then
				warn(("[FabricaViveiro] rig de %s falhou: %s"):format(id, tostring(erro)))
			end
			-- alterna os clipes para a demonstracao
			if clipes then
				local nomes = {}
				for nome in pairs(clipes.Clipes) do
					table.insert(nomes, nome)
				end
				table.sort(nomes)
				task.spawn(function()
					local i = 0
					while modelo.Parent do
						i = i % #nomes + 1
						modelo:SetAttribute("Estado", nomes[i])
						task.wait(math.max(2.5, clipes.Clipes[nomes[i]].Duracao + 0.6))
					end
				end)
			end
			x += 8
		end
	end
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX101"><Properties><string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX102"><Properties><string name="Name">FabricaCliente</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este LocalScript em StarterPlayer > StarterPlayerScripts, com o nome FabricaCliente
-- CLIENTE. Liga tudo: anima todo modelo da fabrica que aparecer e troca camera/movimento pelo atributo
-- "Modo" do jogador ("Grade" ou "Dungeon"; o servidor e quem muda).
-- Nao testado no Studio: confira no piloto.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local pasta = ReplicatedStorage:WaitForChild("Fabrica", 15)
if not pasta then
	warn("[FabricaCliente] nao achei ReplicatedStorage.Fabrica.")
	return
end
local Rig = require(pasta:WaitForChild("Rig"))
local Animador = require(pasta:WaitForChild("Animador"))
local Catalogo = require(pasta:WaitForChild("Catalogo"))
local CameraJogo = require(pasta:WaitForChild("CameraJogo"))
local MovimentoGrade = require(pasta:WaitForChild("MovimentoGrade"))

local registrados: { [Instance]: boolean } = {}

-- anima qualquer modelo que tenha o atributo IdFabrica (posto por Rig.montar no servidor)
local function tentar(inst: Instance)
	if not inst:IsA("Model") or registrados[inst] then
		return
	end
	local id = inst:GetAttribute("IdFabrica")
	if typeof(id) ~= "string" then
		return
	end
	local dados, clipes = Catalogo.dados(id), Catalogo.clipes(id)
	if not dados or not clipes then
		return
	end
	registrados[inst] = true
	task.defer(function()
		local ok, rig = pcall(Rig.ler, inst, dados)
		if ok and rig then
			Animador.registrar(rig, clipes)
		end
	end)
	inst.Destroying:Once(function()
		registrados[inst] = nil
	end)
end

for _, d in ipairs(Workspace:GetDescendants()) do
	tentar(d)
end
Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Model") then
		task.defer(tentar, d)
		d:GetAttributeChangedSignal("IdFabrica"):Connect(function()
			tentar(d)
		end)
	end
end)

-- modo do jogador: Grade (padrao) ou Dungeon
local jogador = Players.LocalPlayer
local function aplicarModo()
	local m = jogador:GetAttribute("Modo")
	if m == "Dungeon" then
		MovimentoGrade.parar()
		CameraJogo.mergulhar()
	elseif m == "Grade" then
		CameraJogo.modoGrade()
		MovimentoGrade.iniciar()
	end
	-- sem atributo: nao mexe na camera (bom para o viveiro de demonstracao)
end
jogador:GetAttributeChangedSignal("Modo"):Connect(aplicarModo)
aplicarModo()
]]></ProtectedString>
