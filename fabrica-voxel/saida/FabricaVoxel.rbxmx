			Orelha_E = {R = {0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0.037,0,0,0.9993,0.0674,0,0,0.9977,0.092,0,0,0.9958,0.1113,0,0,0.9938,0.1261,0,0,0.992,0.1368,0,0,0.9906,0.1443,0,0,0.9895,0.149,0,0,0.9888,0.1516,0,0,0.9884,0.1527,0,0,0.9883,0.153,0,0,0.9882,0.153,0,0,0.9882,0.1529,0,0,0.9882,0.1526,0,-0.0003,0.9883,0.1515,0.0001,-0.001,0.9885,0.149,0.0004,-0.0026,0.9888,0.1441,0.0008,-0.0056,0.9895,0.1359,0.0015,-0.0109,0.9907,0.1229,0.0024,-0.0192,0.9922,0.1036,0.0033,-0.0315,0.9941,0.0762,0.0037,-0.049,0.9959,0.0387,0.0028,-0.0729,0.9966,0,0,-0.1051,0.9945,0,0,-0.1347,0.9909,0,0,-0.1529,0.9882,0,0,-0.1624,0.9867,0,0,-0.1661,0.9861,0,0,-0.1668,0.986,0,0,-0.1666,0.986,0,0,-0.1654,0.9862,0,0,-0.1626,0.9867,0,0,-0.1584,0.9874,0,0,-0.1533,0.9882,0,0,-0.1482,0.989}},
