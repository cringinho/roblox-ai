<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Animador</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome Animador
-- CLIENTE. Toca os clipes assados pela fabrica (modulos Clipes_<Id>) escrevendo Motor6D.Transform.
-- Uma conexao so para todas as criaturas. O servidor so publica o atributo "Estado" no modelo.
-- Motor6D.Transform nao replica e deve ser escrito em RunService.PreSimulation (fonte: documentacao do Motor6D).
-- Nao testado no Studio: confira no piloto.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent:WaitForChild("Config"))

local Animador = {}
local ativos = {} -- [Model] = estado
local conexao: RBXScriptConnection? = nil

local APELIDOS = { Ocioso = "Parado", Passo = "Andar", Mover = "Andar" }

-- quaternion (x, y, z, w) -> CFrame, com interpolacao simples entre dois quadros
local function amostrar(trilha, i0: number, i1: number, a: number, centro: Vector3?): CFrame
	local x, y, z = 0, 0, 0
	local T = trilha.T
	if T then
		local b0, b1 = i0 * 3, i1 * 3
		x = T[b0 + 1] + (T[b1 + 1] - T[b0 + 1]) * a
		y = T[b0 + 2] + (T[b1 + 2] - T[b0 + 2]) * a
		z = T[b0 + 3] + (T[b1 + 3] - T[b0 + 3]) * a
	end
	local R = trilha.R
	if R then
		local b0, b1 = i0 * 4, i1 * 4
		local qx0, qy0, qz0, qw0 = R[b0 + 1], R[b0 + 2], R[b0 + 3], R[b0 + 4]
		local qx1, qy1, qz1, qw1 = R[b1 + 1], R[b1 + 2], R[b1 + 3], R[b1 + 4]
		if qx0 * qx1 + qy0 * qy1 + qz0 * qz1 + qw0 * qw1 < 0 then
			qx1, qy1, qz1, qw1 = -qx1, -qy1, -qz1, -qw1
		end
		return CFrame.new(x, y, z, qx0 + (qx1 - qx0) * a, qy0 + (qy1 - qy0) * a, qz0 + (qz1 - qz0) * a, qw0 + (qw1 - qw0) * a)
	end
	return CFrame.new(x, y, z)
end

local function passo(dtQuadro: number)
	local cam = Workspace.CurrentCamera
	local olho = if cam then cam.CFrame.Position else Vector3.zero
	for modelo, e in pairs(ativos) do
		local dt = dtQuadro
		if not modelo.Parent then
			ativos[modelo] = nil
			continue
		end
		if e.congelado > 0 then
			e.congelado -= dt
			continue
		end
		local raiz = e.rig.Raiz
		local dist = if raiz then (raiz.Position - olho).Magnitude else 0
		if dist > Config.LOD_LONGE then
			continue
		end
		e.saltar = not e.saltar
		if dist > Config.LOD_PERTO and e.saltar then
			e.acumulado += dt
			continue
		end
		dt += e.acumulado
		e.acumulado = 0
		local clipe = e.clipe
		if not clipe then
			continue
		end
		-- fase por distancia: clipes de locomocao andam na velocidade real do modelo
		local vel = e.velocidade
		if clipe.VelRaiz > 0 then
			local v = modelo:GetAttribute("Velocidade")
			if typeof(v) == "number" and v > 0 then
				vel = v / clipe.VelRaiz
			end
		end
		local antes = e.t
		e.t += dt * vel
		local dur = clipe.Duracao
		if clipe.Laco then
			e.t %= dur
		elseif e.t >= dur then
			e.t = dur
			if e.aoTerminar then
				local f = e.aoTerminar
				e.aoTerminar = nil
				task.spawn(f)
			end
		end
		-- marcadores: uma vez por passagem
		for _, m in ipairs(clipe.Marcadores) do
			local tm = m[2]
			if (antes < tm and e.t >= tm) or (clipe.Laco and e.t < antes and (tm > antes or tm <= e.t)) then
				e.marcador:Fire(m[1], e.nome)
			end
		end
		local n = clipe.N
		local f = e.t * 30
		local i0 = math.floor(f)
		local a = f - i0
		local i1 = i0 + 1
		if clipe.Laco then
			i0 %= n
			i1 %= n
		else
			i0 = math.min(i0, n - 1)
			i1 = math.min(i1, n - 1)
		end
		e.mistura = math.min(1, e.mistura + dt / Config.TRANSICAO)
		local k = e.mistura
		for nome, motor in pairs(e.rig.Juntas) do
			local trilha = clipe.Trilhas[nome]
			local alvo = if trilha then amostrar(trilha, i0, i1, a) else CFrame.identity
			if k < 1 then
				local de = e.de[nome] or CFrame.identity
				alvo = de:Lerp(alvo, k * k * (3 - 2 * k))
			end
			motor.Transform = alvo
			e.atual[nome] = alvo
		end
	end
end

function Animador.registrar(rig, clipes)
	if not rig or not clipes then
		return
	end
	local marcador = Instance.new("BindableEvent")
	local e = {
		rig = rig, clipes = clipes.Clipes, clipe = nil, nome = "", t = 0, velocidade = 1, mistura = 1,
		de = {}, atual = {}, congelado = 0, saltar = false, acumulado = 0, marcador = marcador, aoTerminar = nil,
	}
	ativos[rig.Modelo] = e
	if not conexao then
		conexao = RunService.PreSimulation:Connect(passo)
	end
	-- o servidor manda o estado por atributo; o cliente troca de clipe sozinho
	local modelo = rig.Modelo
	local function aplicar()
		local estado = modelo:GetAttribute("Estado")
		if typeof(estado) == "string" then
			Animador.tocar(rig, estado)
		end
	end
	e.sinal = modelo:GetAttributeChangedSignal("Estado"):Connect(aplicar)
	modelo.Destroying:Connect(function()
		Animador.remover(rig)
	end)
	if modelo:GetAttribute("Estado") then
		aplicar()
	else
		Animador.tocar(rig, "Parado")
	end
	return marcador.Event
end

function Animador.tocar(rig, nome: string, opcoes)
	local e = ativos[rig.Modelo]
	if not e then
		return false
	end
	nome = APELIDOS[nome] or nome
	local clipe = e.clipes[nome]
	if not clipe then
		warn(("[Fabrica.Animador] %s nao tem o clipe '%s'."):format(rig.Modelo.Name, nome))
		return false
	end
	if e.clipe == clipe and clipe.Laco then
		return true
	end
	for osso, cf in pairs(e.atual) do
		e.de[osso] = cf
	end
	e.clipe, e.nome, e.t, e.mistura = clipe, nome, 0, 0
	e.velocidade = (opcoes and opcoes.velocidade) or 1
	e.aoTerminar = opcoes and opcoes.aoTerminar or nil
	return true
end

function Animador.congelar(rig, segundos: number) -- hit-stop
	local e = ativos[rig.Modelo]
	if e then
		e.congelado = segundos
	end
end

function Animador.remover(rig)
	local e = ativos[rig.Modelo]
	if e then
		if e.sinal then
			e.sinal:Disconnect()
		end
		e.marcador:Destroy()
		ativos[rig.Modelo] = nil
	end
	if next(ativos) == nil and conexao then
		conexao:Disconnect()
		conexao = nil
	end
end

return Animador
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">CameraJogo</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome CameraJogo
-- CLIENTE. As duas cameras do jogo: grade 2.5D (alta, quase ortografica) e dungeon (primeira pessoa),
-- com o mergulho entre elas e o tranco do susto.
-- Nao testado no Studio: confira no piloto.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent:WaitForChild("Config"))

local CameraJogo = {}
local conexao: RBXScriptConnection? = nil
local modo = ""
local tremor = 0

local function camera(): Camera?
	return Workspace.CurrentCamera
end

local function raizDoHeroi(): BasePart?
	local jogador = Players.LocalPlayer
	local ch = jogador and jogador.Character
	if not ch then
		return nil
	end
	local r = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
	if r and r:IsA("BasePart") then
		return r
	end
	return nil
end

-- distancia para a tela cobrir GRADE_ALTURA_TELA studs com o FOV escolhido
local function distanciaGrade(): number
	return (Config.GRADE_ALTURA_TELA / 2) / math.tan(math.rad(Config.GRADE_FOV / 2))
end

local function cframeGrade(alvo: Vector3): CFrame
	local giro = CFrame.Angles(0, math.rad(Config.GRADE_GUINADA), 0) * CFrame.Angles(math.rad(-Config.GRADE_INCLINACAO), 0, 0)
	return CFrame.new(alvo) * giro * CFrame.new(0, 0, distanciaGrade())
end

local function parar()
	if conexao then
		conexao:Disconnect()
		conexao = nil
	end
end

function CameraJogo.modoGrade()
	local cam = camera()
	local jogador = Players.LocalPlayer
	if not cam or not jogador then
		return
	end
	parar()
	modo = "grade"
	jogador.CameraMode = Enum.CameraMode.Classic
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = Config.GRADE_FOV
	local foco: Vector3? = nil
	conexao = RunService.RenderStepped:Connect(function(dt)
		local r = raizDoHeroi()
		local c = camera()
		if not r or not c then
			return
		end
		local alvo = r.Position
		foco = if foco then foco:Lerp(alvo, math.clamp(dt * Config.GRADE_SUAVIZACAO, 0, 1)) else alvo
		local cf = cframeGrade(foco :: Vector3)
		if tremor > 0 then
			tremor = math.max(0, tremor - dt * 4)
			cf *= CFrame.new((math.noise(os.clock() * 31) * tremor), (math.noise(os.clock() * 37, 5) * tremor), 0)
		end
		c.CFrame = cf
	end)
end

function CameraJogo.modoDungeon()
	local cam = camera()
	local jogador = Players.LocalPlayer
	if not cam or not jogador then
		return
	end
	parar()
	modo = "dungeon"
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = Config.DUNGEON_FOV
	jogador.CameraMode = Enum.CameraMode.LockFirstPerson
end

-- Mergulho: da vista alta ate a cabeca do heroi, depois troca para primeira pessoa.
function CameraJogo.mergulhar(aoTerminar: (() -> ())?)
	local cam = camera()
	local r = raizDoHeroi()
	if not cam or not r then
		CameraJogo.modoDungeon()
		if aoTerminar then
			aoTerminar()
		end
		return
	end
	parar()
	cam.CameraType = Enum.CameraType.Scriptable
	local destino = CFrame.new(r.Position + Vector3.new(0, 1.5, 0)) * (r.CFrame - r.CFrame.Position)
	local info = TweenInfo.new(Config.MERGULHO_SEGUNDOS, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local tw = TweenService:Create(cam, info, { CFrame = destino, FieldOfView = Config.DUNGEON_FOV })
	tw.Completed:Once(function()
		CameraJogo.modoDungeon()
		if aoTerminar then
			aoTerminar()
		end
	end)
	tw:Play()
end

-- Susto: o FOV salta e volta; a camera treme.
function CameraJogo.susto(intensidade: number?)
	local cam = camera()
	if not cam then
		return
	end
	local base = if modo == "dungeon" then Config.DUNGEON_FOV else Config.GRADE_FOV
	local pico = base + (Config.SUSTO_FOV - Config.DUNGEON_FOV) * (intensidade or 1)
	local ida = TweenService:Create(cam, TweenInfo.new(Config.SUSTO_SEGUNDOS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = pico })
	ida.Completed:Once(function()
		TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
	end)
	ida:Play()
	tremor = 0.6 * (intensidade or 1)
end

function CameraJogo.tremer(forca: number)
	tremor = math.max(tremor, forca)
end

function CameraJogo.modo(): string
	return modo
end

return CameraJogo
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Catalogo</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome Catalogo
-- Acha os modulos gerados (Dados_<Id>, Clipes_<Id>) com require protegido e cache.
-- Nao testado no Studio: confira no piloto.

local Catalogo = {}
local cache = {}

local function idLuau(id: string): string
	local out = ""
	for parte in string.gmatch(id, "[^_%.]+") do
		out ..= string.upper(string.sub(parte, 1, 1)) .. string.sub(parte, 2)
	end
	return out
end

local function carregar(pasta: string, prefixo: string, id: string)
	local chave = prefixo .. id
	if cache[chave] ~= nil then
		return cache[chave] or nil
	end
	local dir = script.Parent:FindFirstChild(pasta)
	local modulo = dir and dir:FindFirstChild(prefixo .. idLuau(id))
	if not modulo or not modulo:IsA("ModuleScript") then
		cache[chave] = false
		return nil
	end
	local ok, dados = pcall(require, modulo)
	if not ok then
		warn(("[Fabrica.Catalogo] erro ao carregar %s: %s"):format(modulo.Name, tostring(dados)))
		cache[chave] = false
		return nil
	end
	cache[chave] = dados
	return dados
end

function Catalogo.dados(id: string)
	return carregar("Dados", "Dados_", id)
end

function Catalogo.clipes(id: string)
	return carregar("Clipes", "Clipes_", id)
end

function Catalogo.ids(): { string }
	local lista = {}
	local dir = script.Parent:FindFirstChild("Dados")
	if dir then
		for _, m in ipairs(dir:GetChildren()) do
			if m:IsA("ModuleScript") then
				local ok, d = pcall(require, m)
				if ok and type(d) == "table" and d.Id then
					table.insert(lista, d.Id)
				end
			end
		end
	end
	table.sort(lista)
	return lista
end

return Catalogo
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Config</string>
<ProtectedString name="Source"><![CDATA[-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome Config
-- Todos os numeros ajustaveis do runtime ficam aqui. Nao testado no Studio: confira no piloto.
return {
	LADRILHO = 4, -- studs por casa da grade
	SEGUNDOS_POR_LADRILHO = 0.4444, -- 9 studs/s a pe
	-- camera da grade (2.5D): Scriptable, FOV baixo para parecer ortografica
	GRADE_ALTURA_TELA = 30, -- studs que a tela cobre na vertical, na distancia do heroi
	GRADE_INCLINACAO = 55, -- graus abaixo do horizonte
	GRADE_GUINADA = 35, -- graus em volta do eixo vertical
	GRADE_FOV = 15,
	GRADE_SUAVIZACAO = 8, -- quanto maior, mais rapido a camera alcanca o heroi
	-- dungeon: primeira pessoa
	DUNGEON_FOV = 70,
	MERGULHO_SEGUNDOS = 1.2,
	SUSTO_FOV = 80,
	SUSTO_SEGUNDOS = 0.1,
	HIT_STOP = 0.08,
	-- animacao
	TRANSICAO = 0.15, -- segundos de mistura entre clipes
	LOD_PERTO = 60, -- ate aqui anima todo quadro
	LOD_LONGE = 160, -- alem daqui nao anima
	MAX_CAIXAS = 600, -- teto de Parts por criatura na rota sem importacao
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">ConstrutorParts</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome ConstrutorParts
-- Monta um modelo da Fabrica SEM importar malha: usa a tabela Caixas do modulo Dados_<Id>.
-- Bom para testar e para props; para muitos personagens na tela prefira o modelo.glb importado.
-- Nao testado no Studio: confira no piloto.

local Config = require(script.Parent:WaitForChild("Config"))

local ConstrutorParts = {}

function ConstrutorParts.construir(dados, onde: CFrame?): Model?
	if not dados.Caixas then
		warn(("[Fabrica.ConstrutorParts] Dados_%s nao tem a tabela Caixas."):format(tostring(dados.Id)))
		return nil
	end
	if (dados.TotalCaixas or 0) > Config.MAX_CAIXAS then
		warn(("[Fabrica.ConstrutorParts] %s tem %d caixas (teto %d). Importe o modelo.glb em vez de montar por Parts."):format(
			dados.Id, dados.TotalCaixas, Config.MAX_CAIXAS))
	end
	local base = onde or CFrame.new()
	local modelo = Instance.new("Model")
	modelo.Name = dados.Nome or dados.Id
	local feitas = 0
	for _, peca in ipairs(dados.Pecas) do
		local caixas = dados.Caixas[peca.Nome]
		if caixas then
			-- peca principal invisivel com o nome da peca: e nela que o Rig prende as juntas
			local principal = Instance.new("Part")
			principal.Name = peca.Nome
			principal.Size = Vector3.new(peca.Tamanho[1], peca.Tamanho[2], peca.Tamanho[3])
			principal.CFrame = base * CFrame.new(peca.Centro[1], peca.Centro[2], peca.Centro[3])
			principal.Transparency = 1
			principal.CanCollide = false
			principal.Anchored = true
			principal.Parent = modelo
			local pasta = Instance.new("Folder")
			pasta.Name = "Blocos_" .. peca.Nome
			pasta.Parent = modelo
			for _, c in ipairs(caixas) do
				local b = Instance.new("Part")
				b.Name = "b"
				b.Size = Vector3.new(c[4], c[5], c[6])
				b.CFrame = base * CFrame.new(c[1], c[2], c[3])
				b.Color = Color3.fromHex(c[7])
				b.Material = if c[8] == 1 then Enum.Material.Neon else Enum.Material.SmoothPlastic
				b.TopSurface = Enum.SurfaceType.Smooth
				b.BottomSurface = Enum.SurfaceType.Smooth
				b.CanCollide = false
				b.CanQuery = false
				b.CanTouch = false
				b.Massless = true
				b.Anchored = false
				b.CastShadow = c[8] ~= 1
				local solda = Instance.new("WeldConstraint")
				solda.Part0 = principal
				solda.Part1 = b
				solda.Parent = b
				b.Parent = pasta
				feitas += 1
				if feitas % 200 == 0 then
					task.wait() -- cede o quadro em modelos grandes
				end
			end
		end
	end
	return modelo
end

return ConstrutorParts
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">MovimentoGrade</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome MovimentoGrade
-- CLIENTE. Fora das dungeons o mundo e uma grade de casas de 4 studs e so existe passo nas 4 direcoes.
-- O servidor decide o passo e publica atributos no modelo (PassoDe, PassoPara, PassoT0, PassoDur, Rumo).
-- Este modulo le a entrada, pede o passo e DESENHA o deslocamento de todo modelo que tenha esses atributos.
-- Nao testado no Studio: confira no piloto.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MovimentoGrade = {}
local conexoes: { RBXScriptConnection } = {}
local direcao: Vector3? = nil
local ACAO = "FabricaPassoGrade"

local DIRECOES = {
	[Enum.KeyCode.W] = Vector3.new(0, 0, -1), [Enum.KeyCode.Up] = Vector3.new(0, 0, -1),
	[Enum.KeyCode.S] = Vector3.new(0, 0, 1), [Enum.KeyCode.Down] = Vector3.new(0, 0, 1),
	[Enum.KeyCode.A] = Vector3.new(-1, 0, 0), [Enum.KeyCode.Left] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.D] = Vector3.new(1, 0, 0), [Enum.KeyCode.Right] = Vector3.new(1, 0, 0),
}

-- curva do passo: sai devagar, anda, assenta
local function curva(u: number): number
	return u * u * u * (u * (u * 6 - 15) + 10)
end

local function desenhar()
	local agora = Workspace:GetServerTimeNow()
	for _, modelo in ipairs(CollectionService:GetTagged("FabricaGrade")) do
		if modelo:IsA("Model") and modelo.PrimaryPart then
			local de, para = modelo:GetAttribute("PassoDe"), modelo:GetAttribute("PassoPara")
			local t0, dur = modelo:GetAttribute("PassoT0"), modelo:GetAttribute("PassoDur")
			if typeof(de) == "Vector3" and typeof(para) == "Vector3" and typeof(t0) == "number" and typeof(dur) == "number" then
				local u = math.clamp((agora - t0) / math.max(dur, 0.01), 0, 1)
				local pos = (de :: Vector3):Lerp(para :: Vector3, curva(u))
				local rumo = math.rad(-(modelo:GetAttribute("Rumo") or 0))
				local alvo = CFrame.new(pos) * CFrame.Angles(0, rumo, 0)
				local atual = modelo:GetPivot()
				modelo:PivotTo(CFrame.new(pos) * atual.Rotation:Lerp(alvo.Rotation, 0.3))
			end
		end
	end
end

function MovimentoGrade.iniciar()
	MovimentoGrade.parar()
	local pasta = ReplicatedStorage:WaitForChild("Fabrica"):WaitForChild("Remotos", 10)
	local pedir = pasta and pasta:WaitForChild("PedirPasso", 10)
	if not pedir or not pedir:IsA("RemoteEvent") then
		warn("[Fabrica.MovimentoGrade] nao achei o RemoteEvent Fabrica/Remotos/PedirPasso; o script FabricaGrade do servidor esta rodando?")
		return
	end
	ContextActionService:BindAction(ACAO, function(_, estado, entrada)
		local d = DIRECOES[entrada.KeyCode]
		if d and estado == Enum.UserInputState.Begin then
			direcao = d
		elseif d and estado == Enum.UserInputState.End and direcao == d then
			direcao = nil
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right)
	local espera = 0
	table.insert(conexoes, RunService.Heartbeat:Connect(function(dt)
		espera -= dt
		if direcao and espera <= 0 then
			espera = 0.1 -- o servidor e quem limita a cadencia de verdade
			(pedir :: RemoteEvent):FireServer(direcao)
		end
	end))
	table.insert(conexoes, RunService.RenderStepped:Connect(desenhar))
end

function MovimentoGrade.parar()
	pcall(function()
		ContextActionService:UnbindAction(ACAO)
	end)
	for _, c in ipairs(conexoes) do
		c:Disconnect()
	end
	table.clear(conexoes)
	direcao = nil
end

return MovimentoGrade
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Rig</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coloque este ModuleScript em ReplicatedStorage > Fabrica, com o nome Rig
-- Monta as juntas (Motor6D) de um modelo da Fabrica de Voxel a partir do modulo Dados_<Id>.
-- Funciona com MeshParts importados do modelo.glb (uma peca = um MeshPart com o mesmo nome) e com
-- modelos montados por ConstrutorParts. Idempotente: pode rodar duas vezes sem duplicar nada.
-- Nao testado no Studio: confira no piloto.

local Rig = {}

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

-- Acha os BaseParts do modelo pelo nome (o importador pode aninhar em Models).
local function indexar(modelo: Model): { [string]: BasePart }
	local mapa = {}
	for _, d in ipairs(modelo:GetDescendants()) do
		if d:IsA("BasePart") and mapa[d.Name] == nil then
			mapa[d.Name] = d
		end
	end
	return mapa
end

-- CFrame que leva o espaco do modelo (repouso, da fabrica) para o mundo.
local function origemDoModelo(modelo: Model, dados, partes): CFrame?
	local giro = CFrame.Angles(0, math.rad(modelo:GetAttribute("GiroY") or 0), 0)
	for _, peca in ipairs(dados.Pecas) do
		local p = partes[peca.Nome]
		if p then
			-- o Roblox centraliza cada MeshPart na caixa da malha: Centro (fabrica) -> Position (mundo)
			return CFrame.new(p.Position) * giro * CFrame.new(-v3(peca.Centro))
		end
	end
	return nil
end

function Rig.montar(modelo: Model, dados)
	local partes = indexar(modelo)
	local origem = origemDoModelo(modelo, dados, partes)
	if not origem then
		warn(("[Fabrica.Rig] %s: nenhuma peca de Dados_%s foi achada no modelo. As pecas precisam ter o nome exato (ex.: %s)."):format(
			modelo.Name, tostring(dados.Id), dados.Pecas[1] and dados.Pecas[1].Nome or "?"))
		return nil
	end
	-- 1) peca principal de cada osso; as outras pecas do mesmo osso sao soldadas nela
	local principal: { [string]: BasePart } = {}
	local porOsso: { [string]: { BasePart } } = {}
	for _, peca in ipairs(dados.Pecas) do
		local p = partes[peca.Nome]
		if p then
			porOsso[peca.Osso] = porOsso[peca.Osso] or {}
			table.insert(porOsso[peca.Osso], p)
			if peca.Nome == peca.Osso or principal[peca.Osso] == nil then
				principal[peca.Osso] = p
			end
			local brilho = partes[peca.Nome .. "_Brilho"]
			if brilho then
				brilho.Material = Enum.Material.Neon
				table.insert(porOsso[peca.Osso], brilho)
			end
		else
			warn(("[Fabrica.Rig] %s: peca '%s' esta nos dados mas nao no modelo."):format(modelo.Name, peca.Nome))
		end
	end
	-- 2) osso sem peca (Raiz, juntas vazias): cria uma Part invisivel no pivo
	for _, osso in ipairs(dados.Ossos) do
		if principal[osso.Nome] == nil then
			local p = modelo:FindFirstChild("Osso_" .. osso.Nome)
			if not p then
				p = Instance.new("Part")
				p.Name = "Osso_" .. osso.Nome
				p.Size = Vector3.new(0.2, 0.2, 0.2)
				p.Transparency = 1
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.Parent = modelo
			end
			(p :: BasePart).CFrame = origem * CFrame.new(v3(osso.Pivo))
			principal[osso.Nome] = p :: BasePart
			porOsso[osso.Nome] = porOsso[osso.Nome] or {}
		end
	end
	-- 3) juntas: C0 = pivo no espaco da mae, C1 = pivo no espaco da filha (repouso sem rotacao)
	local juntas: { [string]: Motor6D } = {}
	local raiz: BasePart? = nil
	for _, osso in ipairs(dados.Ossos) do
		local p1 = principal[osso.Nome]
		p1.CanCollide = false
		for _, extra in ipairs(porOsso[osso.Nome]) do
			if extra ~= p1 then
				local nomeSolda = "Solda_" .. extra.Name
				local solda = extra:FindFirstChild(nomeSolda)
				if not solda then
					solda = Instance.new("WeldConstraint")
					solda.Name = nomeSolda
					solda.Parent = extra
				end
				(solda :: WeldConstraint).Part0 = p1;
				(solda :: WeldConstraint).Part1 = extra
				extra.Anchored = false
				extra.Massless = true
				extra.CanCollide = false
			end
		end
		if osso.Pai == "" then
			raiz = p1
			p1.Anchored = true
		else
			local p0 = principal[osso.Pai]
			local pivo = origem * CFrame.new(v3(osso.Pivo))
			local m = p1:FindFirstChild("J_" .. osso.Nome)
			if not m then
				m = Instance.new("Motor6D")
				m.Name = "J_" .. osso.Nome
				m.Parent = p1
			end
			local motor = m :: Motor6D
			motor.Part0 = p0
			motor.Part1 = p1
			motor.C0 = p0.CFrame:ToObjectSpace(pivo)
			motor.C1 = p1.CFrame:ToObjectSpace(pivo)
			p1.Anchored = false
			p1.Massless = true
			juntas[osso.Nome] = motor
		end
	end
	-- 4) soquetes viram Attachments na peca do osso
	for _, s in ipairs(dados.Soquetes or {}) do
		local p = principal[s.Osso]
		if p then
			local a = p:FindFirstChild(s.Nome)
			if not a then
				a = Instance.new("Attachment")
				a.Name = s.Nome
				a.Parent = p
			end
			(a :: Attachment).WorldCFrame = origem * CFrame.new(v3(s.Pos))
		end
	end
	if raiz then
		modelo.PrimaryPart = raiz
	end
	modelo:SetAttribute("IdFabrica", dados.Id)
	modelo:SetAttribute("VersaoFabrica", dados.VersaoFabrica)
	return { Modelo = modelo, Juntas = juntas, Partes = principal, Raiz = raiz, Dados = dados }
end

-- No cliente: so le as juntas que o servidor ja criou.
function Rig.ler(modelo: Model, dados)
	local juntas, partes = {}, {}
	for _, d in ipairs(modelo:GetDescendants()) do
		if d:IsA("Motor6D") and string.sub(d.Name, 1, 2) == "J_" then
			juntas[string.sub(d.Name, 3)] = d
			if d.Part1 then
				partes[string.sub(d.Name, 3)] = d.Part1
			end
		end
	end
	return { Modelo = modelo, Juntas = juntas, Partes = partes, Raiz = modelo.PrimaryPart, Dados = dados }
end

function Rig.soquete(rig, nome: string): Attachment?
	local a = rig.Modelo:FindFirstChild(nome, true)
	if a and a:IsA("Attachment") then
		return a
	end
	return nil
end

return Rig
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX12"><Properties><string name="Name">Dados</string>
</Properties>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Dados_Alado</string>
<ProtectedString name="Source"><![CDATA[-- Coloque este ModuleScript em ReplicatedStorage > Fabrica > Dados, com o nome Dados_Alado
