--!strict
--[[
	SubtypeArtCatalog120.luau
	Coloque em: ReplicatedStorage > Shared > Config  (Rojo: src/shared/Config/)

	GERADO AUTOMATICAMENTE por pipeline/dark_altar/build_subtypes.py.
	Nao edite a mao: edite pipeline/dark_altar/subtypes.py e rode o gerador.

	O que e: dados das 120 Artes de Subtipo (fundo das cartas) em 12 familias de cor.
	Cada entrada descreve uma composicao procedural de xilogravura gotica:
	  fundo (bgHex) + gravura (etchingPattern) + monograma (watermarkGlyph)
	  + emblema concentrico (centerSilhouettes) + particulas (particleGlyph).
	Regras: sem emoji (bloco U+2600-27BF bloqueado); tags so entre colchetes
	([ATQ] [GRD] [BUF] [DEB] [SAC]); glifos geometricos permitidos: ◆ ◇ ▸ † ‡ ▲ ~ ·
	Rotation em graus no sentido horario (igual a GuiObject.Rotation).
	scaleX/scaleY = fracao do quadro da arte (0..1), centrado.
]]

export type EtchingPattern = "SPIKES" | "ARCHES" | "WAVES" | "RAYS" | "ABYSS" | "ROOTS" | "FRACTAL" | "SCALES"
export type SilhouetteShape = "DIAMOND" | "PILLAR" | "RING" | "BLADE" | "CRESCENT" | "CROWN"
export type ParticleGlyph = "·" | "†" | "◆" | "~"
export type ColorFamily =
	"NEUTRO"
	| "AREIA"
	| "VERDE"
	| "BRANCO"
	| "AZUL_CLARO"
	| "AZUL_ESCURO"
	| "MARROM"
	| "PRETO"
	| "ROSA"
	| "VERMELHO"
	| "ROXO"
	| "VINHO"

export type Silhouette = {
	shape: SilhouetteShape,
	scaleX: number,
	scaleY: number,
	rotation: number,
}

export type SubtypeArt = {
	subtypeId: string,
	displayName: string,
	family: ColorFamily,
	order: number,
	bgHex: string,
	accentHex: string,
	etchingPattern: EtchingPattern,
	centerSilhouettes: { Silhouette },
	watermarkGlyph: string,
	particleGlyph: ParticleGlyph,
	isGlitchy: boolean,
}

export type ResolvedColors = {
	bg: Color3,
	accent: Color3,
	accentLight: Color3, -- luz do emblema
	accentShadow: Color3, -- sombra/hachura do emblema
	etch: Color3, -- linhas da gravura (baixo contraste)
	watermark: Color3, -- monograma (quase o fundo)
	ink: Color3, -- contorno de tinta do emblema
}

export type FamilyInfo = { key: ColorFamily, label: string, count: number }

